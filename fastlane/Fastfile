default_platform(:ios)

platform :ios do
  # ──────────────────────────────────────────────
  # Testing & Linting
  # ──────────────────────────────────────────────

  desc "Run unit and UI tests"
  lane :tests do
    setup_xcconfig
    scan(
      project: "Odyssey.xcodeproj",
      scheme: "Odyssey",
      devices: ["iPhone 16 Pro Max"],
      code_coverage: true,
      result_bundle: true
    )
  end

  desc "Run SwiftLint"
  lane :lint do
    swiftlint(
      mode: :lint,
      strict: true,
      reporter: "github-actions-logging"
    )
  end

  # ──────────────────────────────────────────────
  # Screenshots
  # ──────────────────────────────────────────────

  desc "Capture App Store screenshots"
  lane :screenshots do
    setup_xcconfig
    capture_screenshots(
      scheme: "Odyssey",
      devices: ["iPhone 16 Pro Max"],
      languages: ["en-US"],
      output_directory: "./screenshots",
      clear_previous_screenshots: true,
      override_status_bar: true,
      stop_after_first_error: true,
      skip_open_summary: true,
      only_testing: ["OdysseyUITests/AppStoreScreenshotTests"]
    )

    # Generate HTML gallery (fastlane's built-in one doesn't support iPhone 16)
    screenshots_dir = File.expand_path("../screenshots/en-US")
    images = Dir[File.join(screenshots_dir, "*.png")].sort.map { |f| File.basename(f) }
    html = <<~HTML
      <!DOCTYPE html>
      <html><head>
        <title>Odyssey App Store Screenshots</title>
        <style>
          body { background: #1a1a2e; color: #eee; font-family: -apple-system, sans-serif; text-align: center; padding: 40px 20px; }
          h1 { color: #F5A623; }
          .grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; margin-top: 32px; }
          .card { background: #16213e; border-radius: 16px; padding: 16px; }
          .card img { height: 500px; border-radius: 8px; }
          .card p { margin-top: 8px; font-size: 14px; color: #aaa; }
        </style>
      </head><body>
        <h1>Odyssey — App Store Screenshots</h1>
        <p>#{images.length} screenshots captured on #{Time.now.strftime('%B %d, %Y')}</p>
        <div class="grid">
          #{images.map { |f| "<div class='card'><img src='en-US/#{f}' /><p>#{f.sub(/^iPhone \\d+ ?\\w*-/, '').sub('.png', '')}</p></div>" }.join("\n      ")}
        </div>
      </body></html>
    HTML
    File.write("../screenshots/screenshots.html", html)
  end

  # ──────────────────────────────────────────────
  # Beta (TestFlight)
  # ──────────────────────────────────────────────

  desc "Build and upload to TestFlight"
  lane :beta do
    setup_xcconfig
    setup_signing

    # Derive marketing version from current git tag (e.g., v0.3.0 → 0.3.0)
    tag = sh("git describe --tags --abbrev=0 --match 'v*' 2>/dev/null || echo ''").strip
    unless tag.empty?
      version = tag.delete_prefix("v")
      increment_version_number(
        version_number: version,
        xcodeproj: "Odyssey.xcodeproj"
      )
    end

    bump_build

    build_app(
      project: "Odyssey.xcodeproj",
      scheme: "Odyssey",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Odyssey.ipa",
      include_bitcode: false
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  # ──────────────────────────────────────────────
  # Release (App Store)
  # ──────────────────────────────────────────────

  desc "Build and submit to App Store"
  lane :release do |options|
    setup_xcconfig
    setup_signing

    version = options[:version]
    if version
      increment_version_number(
        version_number: version,
        xcodeproj: "Odyssey.xcodeproj"
      )
    end

    bump_build

    build_app(
      project: "Odyssey.xcodeproj",
      scheme: "Odyssey",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Odyssey.ipa",
      include_bitcode: false
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    upload_to_app_store(
      api_key: api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end

  # ──────────────────────────────────────────────
  # Private Lanes
  # ──────────────────────────────────────────────

  private_lane :setup_xcconfig do
    # Write Odyssey.xcconfig from environment variables for CI
    xcconfig_path = "../Odyssey.xcconfig"
    unless File.exist?(xcconfig_path)
      File.write(xcconfig_path, <<~XCCONFIG)
        CLERK_PUBLISHABLE_KEY = #{ENV["CLERK_PUBLISHABLE_KEY"] || ""}
        ODYSSEY_API_BASE_URL = #{ENV["ODYSSEY_API_BASE_URL"] || ""}
      XCCONFIG
    end
  end

  private_lane :setup_signing do
    if is_ci
      create_keychain(
        name: ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_keychain",
        password: ENV["MATCH_KEYCHAIN_PASSWORD"] || "",
        default_keychain: true,
        unlock: true,
        timeout: 3600
      )
    end

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      api_key: api_key,
      readonly: is_ci
    )
  end

  private_lane :bump_build do
    # Monotonic build number from git commit count
    build_number = sh("git rev-list --count HEAD").strip
    increment_build_number(
      build_number: build_number,
      xcodeproj: "Odyssey.xcodeproj"
    )
  end
end
