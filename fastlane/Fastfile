default_platform(:ios)

platform :ios do
  # ──────────────────────────────────────────────
  # Testing & Linting
  # ──────────────────────────────────────────────

  desc "Run unit and UI tests"
  lane :tests do
    setup_xcconfig
    scan(
      project: "Odyssey.xcodeproj",
      scheme: "Odyssey",
      devices: ["iPhone 16"],
      code_coverage: true,
      result_bundle: true
    )
  end

  desc "Run SwiftLint"
  lane :lint do
    swiftlint(
      mode: :lint,
      strict: true,
      reporter: "github-actions-logging"
    )
  end

  # ──────────────────────────────────────────────
  # Beta (TestFlight)
  # ──────────────────────────────────────────────

  desc "Build and upload to TestFlight"
  lane :beta do
    setup_xcconfig
    setup_signing

    bump_build

    build_app(
      project: "Odyssey.xcodeproj",
      scheme: "Odyssey",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Odyssey.ipa",
      include_bitcode: false
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  # ──────────────────────────────────────────────
  # Release (App Store)
  # ──────────────────────────────────────────────

  desc "Build and submit to App Store"
  lane :release do |options|
    setup_xcconfig
    setup_signing

    version = options[:version]
    if version
      increment_version_number(
        version_number: version,
        xcodeproj: "Odyssey.xcodeproj"
      )
    end

    bump_build

    build_app(
      project: "Odyssey.xcodeproj",
      scheme: "Odyssey",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Odyssey.ipa",
      include_bitcode: false
    )

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false
    )

    upload_to_app_store(
      api_key: api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end

  # ──────────────────────────────────────────────
  # Private Lanes
  # ──────────────────────────────────────────────

  private_lane :setup_xcconfig do
    # Write Odyssey.xcconfig from environment variables for CI
    xcconfig_path = "../Odyssey.xcconfig"
    unless File.exist?(xcconfig_path)
      File.write(xcconfig_path, <<~XCCONFIG)
        CLERK_PUBLISHABLE_KEY = #{ENV["CLERK_PUBLISHABLE_KEY"] || ""}
        ODYSSEY_API_BASE_URL = #{ENV["ODYSSEY_API_BASE_URL"] || ""}
      XCCONFIG
    end
  end

  private_lane :setup_signing do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false
    )

    match(
      type: "appstore",
      api_key: api_key,
      readonly: is_ci
    )
  end

  private_lane :bump_build do
    # Monotonic build number from git commit count
    build_number = sh("git rev-list --count HEAD").strip
    increment_build_number(
      build_number: build_number,
      xcodeproj: "Odyssey.xcodeproj"
    )
  end
end
